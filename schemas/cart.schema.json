{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/aletester22/dummyjson-qa-suite/schemas/cart.schema.json",
  "title": "DummyJSON Cart",
  "description": "Shape of a single cart returned by GET /carts/{id}",
  "type": "object",
  "required": [
    "id",
    "products",
    "total",
    "discountedTotal",
    "userId",
    "totalProducts",
    "totalQuantity"
  ],
  "additionalProperties": true,
  "properties": {
    "id":             { "type": "integer", "minimum": 1 },
    "userId":         { "type": "integer", "minimum": 1 },
    "total":          { "type": "number", "minimum": 0 },
    "discountedTotal":{ "type": "number", "minimum": 0 },
    "totalProducts":  { "type": "integer", "minimum": 0 },
    "totalQuantity":  { "type": "integer", "minimum": 0 },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "price", "quantity", "total", "discountPercentage"],
        "additionalProperties": true,
        "properties": {
          "id":                 { "type": "integer", "minimum": 1 },
          "title":              { "type": "string", "minLength": 1 },
          "price":              { "type": "number", "exclusiveMinimum": 0 },
          "quantity":           { "type": "integer", "minimum": 0 },
          "total":              { "type": "number", "minimum": 0 },
          "discountPercentage": { "type": "number", "minimum": 0, "maximum": 100 },
          "discountedPrice":    { "type": "number", "minimum": 0 },
          "thumbnail":          { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
